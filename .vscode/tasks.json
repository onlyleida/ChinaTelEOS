{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "编译并启动项目",
      "type": "shell",
      "command": "./scripts/run_native_app.sh release",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": ["$swift"],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Swift 开发运行",
      "type": "shell",
      "command": "./scripts/run_native_app.sh debug",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": ["$swift"],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      }
    },
    {
      "label": "Push 到 GitHub",
      "type": "shell",
      "command": "./scripts/git_push.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      }
    }
  ]
}
