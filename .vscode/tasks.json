{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "编译并启动项目",
      "type": "shell",
      "command": "./scripts/quit_app.sh && export CLANG_MODULE_CACHE_PATH=\"${TMPDIR:-/private/tmp}/cloudbox-clang-cache\" SWIFTPM_CUSTOM_CACHE_PATH=\"${TMPDIR:-/private/tmp}/cloudbox-swiftpm-cache\" && ./scripts/build_native_app.sh && open \"build/翼存 CloudBox.app\"",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": ["$swift"],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Swift 开发运行",
      "type": "shell",
      "command": "./scripts/quit_app.sh && export CLANG_MODULE_CACHE_PATH=\"${TMPDIR:-/private/tmp}/cloudbox-clang-cache\" SWIFTPM_CUSTOM_CACHE_PATH=\"${TMPDIR:-/private/tmp}/cloudbox-swiftpm-cache\" && swift run CloudBox",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": ["$swift"],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      }
    },
    {
      "label": "Push 到 GitHub",
      "type": "shell",
      "command": "./scripts/git_push.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      }
    }
  ]
}
